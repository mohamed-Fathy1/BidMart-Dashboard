    {
      "name": "⚙️ System Settings",
      "description": "Admin endpoints for reading and updating platform-wide system settings.\n\nGet requires `admin:settings:view`. Update requires `admin:settings:update`.\n\nBase path: /admin/settings",
      "item": [

        {
          "name": "Get Settings",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('success is true', () => pm.expect(res.success).to.equal(true));",
                  "const s = res.data;",
                  "pm.test('has phone_numbers array', () => pm.expect(s.phone_numbers).to.be.an('array'));",
                  "pm.test('has whatsapp_numbers array', () => pm.expect(s.whatsapp_numbers).to.be.an('array'));",
                  "pm.test('dollar_to_riyal_rate is a number', () => pm.expect(s.dollar_to_riyal_rate).to.be.a('number'));",
                  "pm.test('order_commission_percentage 0-100', () => {",
                  "  pm.expect(s.order_commission_percentage).to.be.at.least(0);",
                  "  pm.expect(s.order_commission_percentage).to.be.at.most(100);",
                  "});",
                  "pm.test('referral_amount_sar >= 1', () => pm.expect(s.referral_amount_sar).to.be.at.least(1));",
                  "pm.test('min_liquidation_amount_sar >= 1', () => pm.expect(s.min_liquidation_amount_sar).to.be.at.least(1));",
                  "console.log('Exchange rate:', s.dollar_to_riyal_rate, '| Commission:', s.order_commission_percentage + '%');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Accept-Language", "value": "en" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/settings",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "settings"]
            },
            "description": "Returns the current system settings. All numeric fields are returned as numbers. phone_numbers and whatsapp_numbers are arrays of `{country_code, number}` objects."
          },
          "response": []
