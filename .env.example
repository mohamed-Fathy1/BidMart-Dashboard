# BidMart Dashboard — local environment template.
# Copy to `.env` and fill in the live values for your environment.

# Base URL for the admin REST API. Includes the `/api/v1` prefix.
VITE_API_URL=http://localhost:3000/api/v1

# Origin for the socket.io endpoint (no /api suffix). Optional — if unset,
# the dashboard derives it from VITE_API_URL by trimming the trailing `/api`.
# Example: VITE_SOCKET_URL=https://api.bidmart.sa
# VITE_SOCKET_URL=
